+// 4. Trace file EPERM / EBUSY / EACCES insulation
+
+// 4.1 fs.open
+const origOpen = fs.open;
+fs.open = function (p, ...args) {
+  const cb = args[args.length - 1];
+  if (isTracePath(p) && typeof cb === 'function') {
+    const wrappedCb = (err, fd) => {
+      if (err && isLockingError(err)) {
